    {
      "id": "a1b2c3d4-0009-0009-0009-000000000009",
      "name": "Parse & Split Tips",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1780,
        340
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const claudeResponse = $input.all()[0].json;\nconst rawText = claudeResponse.content?.[0]?.text || '';\nconst rssItem = $('RSS Feed Trigger').first().json;\n\nconst episodeName = rssItem.title || '';\nconst episodeGuid = rssItem.guid || rssItem.id || '';\nconst episodeDate = rssItem.pubDate || rssItem.isoDate || '';\n\nconst itunesEp = rssItem.itunes?.episode || '';\nlet episodeNumber = String(itunesEp).trim();\nif (!episodeNumber) {\n  const m = episodeName.match(/#(\\d+)|[Aa]flevering\\s*(\\d+)|[Ee]p(?:isode|\\.?)\\s*(\\d+)|S\\d+E(\\d+)/);\n  if (m) episodeNumber = m[1] || m[2] || m[3] || m[4] || '';\n}\n\nlet jsonString = rawText.trim();\nconst fenceMatch = jsonString.match(/^```(?:json)?\\s*([\\s\\S]*?)\\s*```$/);\nif (fenceMatch) jsonString = fenceMatch[1].trim();\n\nconst arrayMatch = jsonString.match(/\\[[\\s\\S]*\\]/);\nif (!arrayMatch) {\n  return [{ json: {\n    episodeName, episodeNumber, episodeGuid, episodeDate,\n    tipName: '[PARSE ERROR] Geen geldige JSON van Claude',\n    category: 'andere',\n    timestamp: '00:00:00',\n    notes: 'Raw (500 chars): ' + rawText.slice(0, 500)\n  }}];\n}\n\nlet tips;\ntry {\n  tips = JSON.parse(arrayMatch[0]);\n} catch (e) {\n  return [{ json: {\n    episodeName, episodeNumber, episodeGuid, episodeDate,\n    tipName: '[PARSE ERROR] JSON parse mislukt',\n    category: 'andere',\n    timestamp: '00:00:00',\n    notes: 'Fout: ' + e.message\n  }}];\n}\n\nif (!Array.isArray(tips) || tips.length === 0) return [];\n\nreturn tips.map(tip => ({\n  json: {\n    episodeName,\n    episodeNumber,\n    episodeGuid,\n    episodeDate,\n    tipName: tip.naam || '[geen naam]',\n    category: tip.categorie || 'andere',\n    timestamp: tip.tijdstempel || '00:00:00',\n    notes: tip.notities || ''\n  }\n}));"
      }
    },
