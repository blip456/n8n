    {
      "id": "a1b2c3d4-0007-0007-0007-000000000007",
      "name": "Format Transcript",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1340,
        340
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const whisperOutput = $input.all()[0].json;\nconst segments = whisperOutput.segments || [];\nconst rssItem = $('RSS Feed Trigger').first().json;\nconst CHUNK_DURATION = 30;\n\nfunction formatTime(seconds) {\n  const h = Math.floor(seconds / 3600);\n  const m = Math.floor((seconds % 3600) / 60);\n  const s = Math.floor(seconds % 60);\n  return `${String(h).padStart(2,'0')}:${String(m).padStart(2,'0')}:${String(s).padStart(2,'0')}`;\n}\n\nlet chunks = [], currentChunk = null;\nfor (const seg of segments) {\n  const text = (seg.text || '').trim();\n  if (!text || seg.no_speech_prob > 0.8) continue;\n  if (currentChunk === null || (seg.start - currentChunk.start >= CHUNK_DURATION)) {\n    if (currentChunk?.texts.length) chunks.push(currentChunk);\n    currentChunk = { start: seg.start, texts: [] };\n  }\n  currentChunk.texts.push(text);\n}\nif (currentChunk?.texts.length) chunks.push(currentChunk);\n\nconst compactTranscript = chunks.length\n  ? chunks.map(c => `[${formatTime(c.start)}] ${c.texts.join(' ')}`).join('\\n')\n  : '[Geen spraak gedetecteerd]';\n\nconst systemPrompt = [\n  'Je bent een assistent die luistertips extraheert uit Vlaamse podcast-transcripten.',\n  '',\n  'Een luistertip is een expliciete aanbeveling van de host of een gast: een boek, podcast, documentaire,',\n  'film, muziek, website, of iets anders om te beluisteren, lezen, bekijken of bezoeken.',\n  'Terloopse vermeldingen zonder aanbevelende toon tellen NIET mee.',\n  '',\n  'Zoek naar zinnen als: \"Ik raad aan\", \"Zeker luisteren naar\", \"Dat boek van\", \"Check zeker eens\",',\n  '\"Kijk zeker naar\", \"Ik ben momenteel aan het lezen\", \"Wij zijn fan van\".',\n  '',\n  'Gebruik de tijdstempel van het BEGIN van de zin waarin de tip wordt vermeld.',\n  'Voor \"naam\": geef de volledige officiele naam (auteur + titel voor boeken).',\n  'Voor \"notities\": 1-2 zinnen context.',\n  '',\n  'Geef je antwoord UITSLUITEND als een JSON-array, zonder uitleg, zonder markdown, zonder codetags:',\n  '[{\"naam\":\"...\",\"categorie\":\"boek|podcast|documentaire|film|muziek|website|andere\",\"tijdstempel\":\"HH:MM:SS\",\"notities\":\"...\"}]',\n  '',\n  'Als er geen luistertips zijn: []'\n].join('\\n');\n\nconst episodeTitle = rssItem.title || 'Onbekend';\nconst userMessage = `Aflevering: ${episodeTitle}\\n\\nTranscript (gesegmenteerd per 30 seconden):\\n${compactTranscript}`;\n\nconst claudeRequestBody = JSON.stringify({\n  model: 'claude-haiku-4-5-20251001',\n  max_tokens: 2048,\n  system: systemPrompt,\n  messages: [{ role: 'user', content: userMessage }]\n});\n\nreturn [{\n  json: {\n    compactTranscript,\n    claudeRequestBody,\n    episodeTitle,\n    episodeGuid: rssItem.guid || rssItem.id || '',\n    episodePubDate: rssItem.pubDate || rssItem.isoDate || '',\n    itunesEpisode: rssItem.itunes?.episode || ''\n  }\n}];"
      }
    },
    {
      "id": "a1b2c3d4-0008-0008-0008-000000000008",
      "name": "Extract Tips - Claude",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1560,
        340
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "anthropicApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "string",
        "body": "={{ $json.claudeRequestBody }}",
        "options": {
          "timeout": 60000,
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
